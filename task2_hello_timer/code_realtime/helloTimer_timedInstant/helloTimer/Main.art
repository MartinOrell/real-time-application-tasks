capsule Main{

    [[rt::header_preface]]
    `
        #include <chrono>
    `

    [[rt::impl_preface]]
    `
        #include <iostream>
        #include <fstream>
    `

    [[rt::decl]]
    `
        private:
            std::chrono::steady_clock::time_point _startTime;
            std::chrono::steady_clock::time_point _endTime;
    `

    behavior port timerOut : InstantTimerProtocol, timerIn~ : InstantTimerProtocol;
    connect timerIn with timerOut;

    statemachine{
        initial ->Waiting
        `
            _startTime = std::chrono::steady_clock::now();
        `;
        state Waiting{
            entry
            `
                timerOut.instantTimeout().send();
                std::cout << "Hello World!" << std::endl;
            `;
        };
        Waiting->End on timerIn.instantTimeout;
        state End{
            entry
            `
                std::cout << "Goodbye World!" << std::endl;

                _endTime = std::chrono::steady_clock::now();
                auto nSecDuration = std::chrono::duration_cast<std::chrono::nanoseconds>(_endTime-_startTime).count();
                std::cout << "Time: " << nSecDuration << "ns" << std::endl;

                std::ofstream out;
                std::string fileName = "..\\..\\helloTimer\\results.txt";
                out.open(fileName, std::ios::app);
                out << nSecDuration << std::endl;

                context()->abort();
            `;
        };
    };
};