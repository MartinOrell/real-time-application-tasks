capsule Printer{

    [[rt::header_preface]]
    `
        #include <vector>
    `

    [[rt::impl_preface]]
    `
        #include <iostream>
    `

    [[rt::decl]]
    `
        public:
            Printer(RTController*, RTActorRef*, RTTimespec);
        private:
            RTTimespec _tickInterval;
            std::vector<int> _digitValues;
            int _numRequests;
            int _numResponses;
    `

    [[rt::impl]]
    `
        Printer::Printer(RTController* rtg_rts, RTActorRef* rtg_ref,  RTTimespec tickInterval)
            :RTActor(rtg_rts, rtg_ref), _tickInterval{tickInterval}{}
    `

    behavior port timer : Timing;

    service notify behavior port digitPorts~ : DigitPrinterProtocol[100];

    statemachine{

        state Running{
            on digitPorts.rtBound
            `
                _digitValues.push_back(0);
            `;
        };

        state Receiving;
        choice isAllReceived;

        initial ->Running
        `
            timer.informEvery(_tickInterval);
        `;
        
        requestDigits: Running->Receiving on timer.timeout
        `
            _numResponses = 0;
            _numRequests = _digitValues.size();
            for(int i = 0; i < _numRequests; i++)
            {
                digitPorts.requestDigit().sendAt(i);
            }
        `;

        storeDigit: Receiving->isAllReceived on digitPorts.respondDigit
        `
            int index = (*getMsg()).sapIndex0();
            _digitValues.at(index) = *((int*) rtdata);
            _numResponses++;
        `;

        
        yes: isAllReceived->Running when `_numResponses >= _numRequests`
        `
            for(int i = _digitValues.size()-1; i >= 0; i--){
                std::cout << _digitValues.at(i);
            }
            std::cout << " ";
        `;
        no: isAllReceived->Receiving when `else`;
    };
};